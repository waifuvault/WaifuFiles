{
    "name": "waifuvault-uploader",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "overrides": {
        "eslint-plugin-vitest": {
            "@typescript-eslint/utils": "^8.39.1"
        }
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start -H localhost",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier ./app --check",
        "prettier:fix": "prettier ./app --write",
        "update_deps": "npx npm-check-updates",
        "prepare": "husky"
    },
    "dependencies": {
        "@types/qrcode": "^1.5.6",
        "bootstrap-icons": "^1.13.1",
        "globals": "^17.6.0",
        "next": "^16.2.6",
        "qrcode": "^1.5.4",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "waifuvault-node-api": "^1.9.0"
    },
    "devDependencies": {
        "@types/node": "^25.8.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.4.0",
        "eslint-config-next": "^16.2.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "tsc-files": "^1.1.4",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "app/**/*.{ts,tsx,js,jsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ],
        "app/**/*.{css,scss,less,json,md,yaml,yml}": [
            "prettier --write"
        ]
    }
}
